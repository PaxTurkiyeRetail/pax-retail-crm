# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crm_local

# Uygulama ve oturum
APP_BASE_URL=http://localhost:3000
AUTH_COOKIE_NAME=pax_crm_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12
AUTH_RESET_TTL_MINUTES=30
AUTH_LOCAL_LOGIN_ENABLED=true
NEXT_PUBLIC_LOCAL_LOGIN_ENABLED=true
TRUST_PROXY_HEADERS=false
AUTH_RATE_LIMIT_MEMORY_FALLBACK=false

# Entra ID / OIDC (kurumsal giriş)
NEXT_PUBLIC_OIDC_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_STATE_SECRET=replace-with-at-least-32-random-characters
OIDC_SYNC_GROUP_ROLES=false

# Parola sıfırlama e-postası (opsiyonel)
AUTH_EMAIL_FROM=PAX CRM <noreply@example.com>
RESEND_API_KEY=

# Jira entegrasyonu (opsiyonel)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_RETAIL_SUPPORT_JQL=
JIRA_COMPANY_FIELD_ID=
JIRA_ORGANIZATION_FIELD_ID=

# Veritabanı yedeği (opsiyonel)
DB_BACKUP_DIR=./backups
PG_DUMP_PATH=pg_dump
# Native shell build-time URL. HTTPS zorunludur; yalnız yerel debug için http kullanılabilir.
CAPACITOR_SERVER_URL=https://crm.example.com
NEXT_PUBLIC_MOBILE_MIN_VERSION_ANDROID=1.0.0
NEXT_PUBLIC_MOBILE_MIN_VERSION_IOS=1.0.0
NEXT_PUBLIC_CRM_HOST=crm.example.com
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.paxturkiye.crm
MOBILE_IOS_STORE_URL=https://apps.apple.com/app/id0000000000
