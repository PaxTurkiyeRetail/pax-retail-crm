{
  "name": "psql-crm-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "check:build": "node scripts/prebuild-check.mjs",
    "qa:crm": "node scripts/crm-qa-agent.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:preflight": "node --env-file-if-exists=.env.local scripts/preflight-live.mjs",
    "db:backup:predeploy": "node --env-file-if-exists=.env.local scripts/predeploy-backup.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:build && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "jszip": "^3.10.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.23",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.23",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0"
  }
}
